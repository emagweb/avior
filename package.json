{
  "name": "avior",
  "version": "0.1.0",
  "description": "A starter stack for websites: React, Rsbuild and Sass utilities named after the Emmet dictionary. No external grid, no UI library.",
  "author": "Antonina Osypenko (https://github.com/emagweb)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emagweb/avior.git"
  },
  "bugs": {
    "url": "https://github.com/emagweb/avior/issues"
  },
  "homepage": "https://github.com/emagweb/avior#readme",
  "keywords": [
    "emmet",
    "sass",
    "utility-classes",
    "css-framework",
    "rsbuild",
    "react"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-publish.mjs",
    "build": "rsbuild build",
    "start": "rsbuild dev --open",
    "preview": "rsbuild preview"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.6.14",
    "@rsbuild/plugin-image-compress": "^1.3.1",
    "@rsbuild/plugin-react": "^1.4.2",
    "@rsbuild/plugin-sass": "^1.4.0"
  },
  "packageManager": "yarn@4.1.1"
}
